{
  "name": "forever-party-album",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "worker:dev": "vite build && wrangler dev",
    "worker:deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "client-zip": "^2.5.1",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "sharp@0.35.5": true
  }
}
